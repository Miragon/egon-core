{
    "name": "egon-core",
    "version": "0.0.1",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "packageManager": "yarn@4.12.0",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/style.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Miragon/egon-core.git"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --mode development",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:coverage": "vitest run --project unit --coverage",
        "test:browser": "vitest run --project browser",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "prepack": "yarn build"
    },
    "dependencies": {
        "@bpmn-io/align-to-origin": "0.7.0",
        "diagram-js": "15.24.0",
        "diagram-js-direct-editing": "3.5.1",
        "didi": "11.0.0",
        "ids": "3.0.2",
        "min-dash": "5.1.0",
        "min-dom": "5.3.0",
        "tiny-svg": "4.1.4"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.1.2",
        "@vitest/browser": "4.1.10",
        "@vitest/coverage-v8": "4.1.10",
        "archunit": "2.4.0",
        "bpmn-font": "0.13.0",
        "diagram-js-minimap": "5.4.1",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "jsdom": "30.0.1",
        "playwright": "1.62.1",
        "prettier": "3.9.6",
        "sass": "1.102.0",
        "tslib": "2.8.1",
        "typescript": "5.7.3",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.0",
        "vite-plugin-dts": "5.0.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.10"
    }
}

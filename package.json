{
  "name": "egon-core",
  "version": "0.0.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.12.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/egon-core.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "prepack": "yarn build"
  },
  "dependencies": {
    "diagram-js": "^15.2.4",
    "diagram-js-direct-editing": "^3.2.0",
    "didi": "^10.2.2",
    "ids": "^1.0.5",
    "min-dash": "^4.2.2",
    "min-dom": "4.2.1",
    "tiny-svg": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^22.8.6",
    "@vitest/coverage-v8": "^3.2.4",
    "bpmn-font": "^0.12.1",
    "diagram-js-minimap": "^5.2.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "~22.1.0",
    "prettier": "^3.4.1",
    "sass": "^1.93.3",
    "tslib": "^2.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "~3.8.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}

{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist/out-tsc",
        "types": ["vitest/globals", "node"],
        "resolveJsonModule": true
    },
    "include": [
        "src/**/__tests__/**/*.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx",
        "src/**/*.d.ts"
    ]
}

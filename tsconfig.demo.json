{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "types": ["node", "vite/client", "@playwright/test"],
        "baseUrl": ".",
        "paths": {
            "egon-core": ["./src/index.ts"],
            "egon-core/style.css": ["./src/styles.scss"]
        },
        "noEmit": true
    },
    "include": ["demo/**/*.ts", "playwright.config.ts", "src/types/**/*.d.ts"]
}
